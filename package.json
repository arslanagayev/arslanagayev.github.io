{
  "name": "terminal-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "My portfolio as a terminal: type help, projects or contact, with tab completion, history and typo suggestions.",
  "keywords": [
    "portfolio",
    "terminal",
    "cli",
    "typescript",
    "vite",
    "accessibility"
  ],
  "author": {
    "name": "Arslan Agayev",
    "url": "https://github.com/arslanagayev"
  },
  "license": "MIT",
  "homepage": "https://arslanagayev.github.io/",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
